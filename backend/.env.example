# ============================================================
# DocReview BD — Environment Variables (MS SQL Server Edition)
# এই ফাইলটি copy করে .env নামে save করুন
# ============================================================

# Server port (default: 3000)
PORT=3000

# Environment
NODE_ENV=development

# ── JWT Secret ───────────────────────────────────────────────
# Generate করুন:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=


# ── AES-256-GCM Encryption Key ────────────────────────────────
# Generate করুন (64 hex chars = 32 bytes = 256 bits):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️  Production-এ অবশ্যই নিজের key দিন!
# ⚠️  এই key হারিয়ে গেলে database-এর সব data পড়া যাবে না!
ENC_KEY=

# ── Microsoft SQL Server ──────────────────────────────────────
# SQL Server-এর address (IP বা hostname)
DB_SERVER=localhost

# SQL Server port (default: 1433)
DB_PORT=1433

# Database নাম — আগে SQL Server-এ এই database তৈরি করুন:
#   CREATE DATABASE docreview_bd;
DB_NAME=docreview_bd

# SQL Server username
DB_USER=sa

# SQL Server password
DB_PASSWORD=

# Azure SQL ব্যবহার করলে true, local হলে false
DB_ENCRYPT=false

# Self-signed certificate থাকলে true (local development)
DB_TRUST_CERT=true

# ── CORS ─────────────────────────────────────────────────────
# Production-এ আপনার domain দিন
ALLOWED_ORIGIN=*
